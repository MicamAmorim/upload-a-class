{
  "manifest_version": 3,
  "name": "Aulas — E-Class + 7Edu · 4º Bimestre 2026",
  "version": "1.0.10",
  "description": "Planejamento independente 7Edu, agora com Filosofia (módulos 8 a 12) em aulas expositivas e exercícios, sujeito a aprovação e datas oficiais.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://portal.educacaoadventista.org.br/*",
    "https://api-eclass.educacaoadventista.org.br/*",
    "https://api-usuario.educacaoadventista.org.br/*",
    "https://7edu-br.educadventista.org/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Aulas 4º Bimestre",
    "default_popup": "popup.html"
  }
}
