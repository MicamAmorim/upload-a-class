{
  "manifest_version": 3,
  "name": "Aulas — E-Class + 7Edu · 4º Bimestre 2026",
  "version": "1.0.6",
  "description": "Lançamento supervisionado de aulas no E-Class e 7Edu, com validação de turmas, datas, horários e duplicatas.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://portal.educacaoadventista.org.br/*",
    "https://api-eclass.educacaoadventista.org.br/*",
    "https://api-usuario.educacaoadventista.org.br/*",
    "https://7edu-br.educadventista.org/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Aulas 4º Bimestre",
    "default_popup": "popup.html"
  }
}
